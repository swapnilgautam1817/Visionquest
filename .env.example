# ==============================================================================
# OPTICGUARD AI - MASTER ENVIRONMENT CONFIGURATION (TEMPLATE)
# Platform: Tri-System Architecture (Client -> Vercel, Backend -> Render, Supabase)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT CONFIGURATION (client/.env) - Vercel Deployment Target
# ------------------------------------------------------------------------------
VITE_API_URL=https://opticguard-backend.onrender.com/api
VITE_WS_URL=wss://opticguard-backend.onrender.com/ws
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. SERVER GATEWAY CONFIGURATION (server/.env) - Stream Relay Target
# ------------------------------------------------------------------------------
GATEWAY_PORT=5001
BACKEND_SERVICE_URL=https://opticguard-backend.onrender.com

# ------------------------------------------------------------------------------
# 3. BACKEND CONFIGURATION (backend/.env) - Render Deployment & Supabase Core
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
HOST=0.0.0.0
CLIENT_ORIGIN=https://your-opticguard-client.vercel.app,http://localhost:3000

# Supabase Credentials (Anon Key + Service Role Secret Key + URL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Google Gemini Visual Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anomaly Thresholds & Telemetry
ANOMALY_CONFIDENCE_THRESHOLD=0.65
ENABLE_SIMULATED_STREAMS=true
ALERT_SOUND_ENABLED=true
ALERT_WEBHOOK_URL=https://webhook.site/opticguard-demo-endpoint
STORAGE_DIR=./uploads
DATABASE_FILE=./src/database/opticguard.db.json
