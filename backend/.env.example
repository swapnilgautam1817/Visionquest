# ==============================================================================
# OPTICGUARD AI - BACKEND ENVIRONMENT SPECIFICATION (TEMPLATE)
# System: Core Backend Service (Render Deployment & Supabase Data Engine)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0
CLIENT_ORIGIN=https://your-opticguard-client.vercel.app,http://localhost:3000

# Supabase Cloud Database & Storage Credentials
# Found at: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Google Gemini Visual Intelligence Engine
# Found at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Visual Intelligence Inference & Anomaly Thresholds
ANOMALY_CONFIDENCE_THRESHOLD=0.65
HEATMAP_RESOLUTION=32
MAX_DETECTIONS_PER_FRAME=8
ENABLE_GPU_ACCELERATION_SIMULATION=true

# Stream & Telemetry Settings
ENABLE_SIMULATED_STREAMS=true
STREAM_FPS=15
WS_HEARTBEAT_INTERVAL=10000

# Incident Escalation & Notification Dispatch
ALERT_SOUND_ENABLED=true
INCIDENT_AUTO_NOTIFY_SEVERITY=HIGH
ALERT_WEBHOOK_URL=https://webhook.site/opticguard-demo-endpoint

# Storage & Persistence
STORAGE_DIR=./uploads
DATABASE_FILE=./src/database/opticguard.db.json
MAX_UPLOAD_SIZE_MB=50

